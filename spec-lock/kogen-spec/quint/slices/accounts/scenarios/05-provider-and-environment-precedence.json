    {"do":["Use",{"provider":"grok","label":"team-x","project":"alpha","projectExists":true}],"expect":{"last":"ok","grokAlpha":"team-x"}},
    {"do":["Project",{"name":"alpha","exists":true,"provider":"grok","account":"default"}]},
    {"do":["SelectionDefault",{"provider":"chatgpt"}]},
    {"do":["Resolve",{"project":"alpha"}],"expect":{"resolvedProvider":"grok","resolvedLabel":"team-x","resolvedSaved":true}},
    {"do":["Environment",{"provider":"chatgpt","account":"work"}]},
    {"do":["Resolve",{"project":"alpha"}],"expect":{"resolvedProvider":"chatgpt","resolvedLabel":"work","resolvedSaved":true}}
  ]
