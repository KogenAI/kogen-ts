{
  "name": "05-provider-and-environment-precedence",
  "about": "Environment provider/account override project and machine settings; otherwise project provider and account rows take precedence.",
  "steps": [
    {"do":["Seed",{"provider":"grok","label":"team-x","present":true,"saved":true,"signedIn":true,"email":"g@example.test","expires":0,"hasExpiry":false,"notice":false,"remoteRevoked":false}]},
