{
  "name": "06-landed-and-missing",
  "about": "A landed Intent removes without --force and drops the approval ref. Missing and unknown slugs exit 2. Shaping an approved Intent does not touch the ref.",
  "steps": [
    {"do": ["Remove", {"slug": "alpha", "force": true}], "expect": {"last": "intent/not_found", "exit": 2}},
    {"do": ["Shape", {"slug": "nope", "result": "valid"}], "expect": {"last": "unknown_slug", "exit": 2}},
    {"do": ["Shape", {"slug": "alpha", "result": "valid"}]},
    {"do": ["Approve", {"slug": "alpha", "mode": "commit", "hash": "abcd1234", "prefixOk": true, "race": "none"}]},
    {"do": ["Shape", {"slug": "alpha", "result": "valid"}], "expect": {"did": "shaped", "refs": {"alpha": {"n": 1, "hash": "abcd1234"}}, "life": {"alpha": "approved"}}},
    {"do": ["Adopt", {"slug": "alpha", "status": "building"}]},
    {"do": ["Adopt", {"slug": "alpha", "status": "landed"}], "expect": {"life": {"alpha": "landed"}}},
    {"do": ["Remove", {"slug": "alpha", "force": false}], "expect": {"did": "removed", "refs": {}, "life": {}}}
  ]
}
