{
 "name": "16-shaping-eight-attempts-exit4",
 "about": "Shaping stops (exit 4) when the 8th attempt of a request fails; model switch rules still apply.",
 "steps": [
  {
   "do": [
    "Stage",
    {
     "name": "shape",
     "mode": "shaping",
     "model": "luna",
     "fallback": "sol",
     "owned": true
    }
   ]
  },
  {
   "do": [
    "Request"
   ]
  },
  {
   "do": [
    "Attempt",
    {
     "result": "overload",
     "retry_after_ms": -1,
     "elapsed_ms": 1000,
     "first_byte_ms": 500,
     "max_gap_ms": 0
    }
   ],
   "expect": {
    "attempts": 1
   }
  },
  {
   "do": [
    "Attempt",
    {
     "result": "overload",
     "retry_after_ms": -1,
     "elapsed_ms": 1000,
     "first_byte_ms": 500,
     "max_gap_ms": 0
    }
   ],
   "expect": {
    "attempts": 2
   }
  },
  {
   "do": [
    "Attempt",
    {
     "result": "overload",
     "retry_after_ms": -1,
     "elapsed_ms": 1000,
     "first_byte_ms": 500,
     "max_gap_ms": 0
    }
   ],
   "expect": {
    "attempts": 3,
    "decision": {
     "kind": "switch",
     "delay_ms": 8000,
     "reason": "overload",
     "model": "sol"
    },
    "model": "sol"
   }
  },
  {
   "do": [
    "Attempt",
    {
     "result": "overload",
     "retry_after_ms": -1,
     "elapsed_ms": 1000,
     "first_byte_ms": 500,
     "max_gap_ms": 0
    }
   ],
   "expect": {
    "attempts": 4
   }
  },
  {
   "do": [
    "Attempt",
    {
     "result": "overload",
     "retry_after_ms": -1,
     "elapsed_ms": 1000,
     "first_byte_ms": 500,
     "max_gap_ms": 0
    }
   ],
   "expect": {
    "attempts": 5
   }
  },
  {
   "do": [
    "Attempt",
    {
     "result": "overload",
     "retry_after_ms": -1,
     "elapsed_ms": 1000,
     "first_byte_ms": 500,
     "max_gap_ms": 0
    }
   ],
   "expect": {
    "attempts": 6
   }
  },
  {
   "do": [
    "Attempt",
    {
     "result": "overload",
     "retry_after_ms": -1,
     "elapsed_ms": 1000,
     "first_byte_ms": 500,
     "max_gap_ms": 0
    }
   ],
   "expect": {
    "attempts": 7
   }
  },
  {
   "do": [
    "Attempt",
    {
     "result": "overload",
     "retry_after_ms": -1,
     "elapsed_ms": 1000,
     "first_byte_ms": 500,
     "max_gap_ms": 0
    }
   ],
   "expect": {
    "decision": {
     "kind": "stop",
     "delay_ms": 0,
     "reason": "provider/overload"
    },
    "phase": "stopped",
    "exit": 4,
    "attempts": 8
   }
  }
 ]
}