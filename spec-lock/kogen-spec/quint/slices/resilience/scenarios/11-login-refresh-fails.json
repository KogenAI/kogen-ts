{
 "name": "11-login-refresh-fails",
 "about": "If the forced refresh fails the Build stops with provider/login, exit 4.",
 "steps": [
  {
   "do": [
    "Stage",
    {
     "name": "build",
     "mode": "build",
     "model": "luna",
     "fallback": "sol",
     "owned": true
    }
   ]
  },
  {
   "do": [
    "Request"
   ]
  },
  {
   "do": [
    "Attempt",
    {
     "result": "login",
     "retry_after_ms": -1,
     "elapsed_ms": 1000,
     "first_byte_ms": 500,
     "max_gap_ms": 0
    }
   ]
  },
  {
   "do": [
    "Refresh",
    false
   ],
   "expect": {
    "decision": {
     "kind": "stop",
     "delay_ms": 0,
     "reason": "provider/login"
    },
    "phase": "stopped",
    "exit": 4,
    "journal": []
   }
  }
 ]
}