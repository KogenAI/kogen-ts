{
 "name": "07-usage-limit-waits",
 "about": "usage_limit waits retry_after_ms, or 15 min when absent, with the budget paused (only request time is charged); no backoff ladder retry; provider_wait recorded; success clears the usage-limit total.",
 "steps": [
  {
   "do": [
    "Stage",
    {
     "name": "build",
     "mode": "build",
     "model": "luna",
     "fallback": "sol",
     "owned": true
    }
   ]
  },
  {
   "do": [
    "Request"
   ]
  },
  {
   "do": [
    "Attempt",
    {
     "result": "usage_limit",
     "retry_after_ms": 5000,
     "elapsed_ms": 300,
     "first_byte_ms": 500,
     "max_gap_ms": 0
    }
   ],
   "expect": {
    "decision": {
     "kind": "wait",
     "delay_ms": 5000,
     "reason": "usage_limit",
     "model": "luna"
    },
    "journal": [
     {
      "event": "provider_wait",
      "stage": "",
      "rung": 0,
      "reason": "usage_limit",
      "ms": 5000,
      "from_model": "",
      "to_model": ""
     }
    ],
    "budget_ms": 300,
    "usage_ms": 5000,
    "retries": 0
   }
  },
  {
   "do": [
    "Attempt",
    {
     "result": "usage_limit",
     "retry_after_ms": -1,
     "elapsed_ms": 300,
     "first_byte_ms": 500,
     "max_gap_ms": 0
    }
   ],
   "expect": {
    "decision": {
     "kind": "wait",
     "delay_ms": 900000,
     "reason": "usage_limit",
     "model": "luna"
    },
    "journal": [
     {
      "event": "provider_wait",
      "stage": "",
      "rung": 0,
      "reason": "usage_limit",
      "ms": 5000,
      "from_model": "",
      "to_model": ""
     },
     {
      "event": "provider_wait",
      "stage": "",
      "rung": 0,
      "reason": "usage_limit",
      "ms": 900000,
      "from_model": "",
      "to_model": ""
     }
    ],
    "budget_ms": 600,
    "usage_ms": 905000
   }
  },
  {
   "do": [
    "Attempt",
    {
     "result": "ok",
     "retry_after_ms": -1,
     "elapsed_ms": 300,
     "first_byte_ms": 500,
     "max_gap_ms": 0
    }
   ],
   "expect": {
    "decision": {
     "kind": "success",
     "delay_ms": 0,
     "reason": ""
    },
    "budget_ms": 900,
    "usage_ms": 0,
    "exit": 0
   }
  }
 ]
}