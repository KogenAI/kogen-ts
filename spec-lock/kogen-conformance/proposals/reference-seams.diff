diff --color -ruN -x *.beam -x .DS_Store kogen-ref-base/lib/kogen/contracts/acceptance_adapter.ex kogen-ref-patched97/lib/kogen/contracts/acceptance_adapter.ex
--- a/lib/kogen/contracts/acceptance_adapter.ex	1970-01-01 03:00:00
+++ b/lib/kogen/contracts/acceptance_adapter.ex	2026-10-05 16:52:10
@@ -0,0 +1,42 @@
+defmodule Kogen.Contracts.AcceptanceAdapter do
+  @moduledoc """
+  The project's acceptance adapter (spec §2.4.3): `exunit` (default) or `command`.
+
+  Proposal patch: the loaded project's adapter is held process-wide, since one CLI call
+  loads one project.
+  """
+
+  defstruct adapter: :exunit,
+            ext: "_test.exs",
+            candidate_dir: "test/acceptance",
+            run: nil,
+            timeout_ms: 600_000
+
+  @type t :: %__MODULE__{
+          adapter: :exunit | :command,
+          ext: String.t(),
+          candidate_dir: String.t(),
+          run: [String.t()] | nil,
+          timeout_ms: pos_integer()
+        }
+
+  @key {__MODULE__, :current}
+
+  @spec put(t()) :: :ok
+  def put(%__MODULE__{} = adapter), do: :persistent_term.put(@key, adapter)
+
+  @spec current() :: t()
+  def current, do: :persistent_term.get(@key, %__MODULE__{})
+
+  @spec ext() :: String.t()
+  def ext, do: current().ext
+
+  @spec source_path(String.t()) :: String.t()
+  def source_path(slug), do: ".kogen/acceptance/#{slug}#{ext()}"
+
+  @spec candidate_path(String.t()) :: String.t()
+  def candidate_path(slug), do: "#{current().candidate_dir}/#{slug}#{ext()}"
+
+  @spec candidate_dir() :: String.t()
+  def candidate_dir, do: current().candidate_dir
+end
diff --color -ruN -x *.beam -x .DS_Store kogen-ref-base/lib/kogen/contracts/seams.ex kogen-ref-patched97/lib/kogen/contracts/seams.ex
--- a/lib/kogen/contracts/seams.ex	1970-01-01 03:00:00
+++ b/lib/kogen/contracts/seams.ex	2026-10-05 16:52:10
@@ -0,0 +1,66 @@
+defmodule Kogen.Contracts.Seams do
+  @moduledoc """
+  Conformance test seams (spec §4.1, §5.3). Production never sets them.
+
+  - `KOGEN_PROVIDER_URL` replaces the Responses URL in both credential modes.
+  - `KOGEN_AUTH_URL` replaces `https://auth.openai.com` for login, refresh, discovery and JWKS.
+  - `KOGEN_TIME_SCALE` multiplies scaled constants.
+  - `KOGEN_SANDBOX=unavailable` builds unconfined with a warning.
+  """
+
+  @auth_base "https://auth.openai.com"
+
+  @spec responses_url(String.t()) :: String.t()
+  def responses_url(default) do
+    case System.get_env("KOGEN_PROVIDER_URL") do
+      url when is_binary(url) and url != "" -> url
+      _unset -> default
+    end
+  end
+
+  @spec auth_url(String.t()) :: String.t()
+  def auth_url(@auth_base <> path) do
+    case System.get_env("KOGEN_AUTH_URL") do
+      url when is_binary(url) and url != "" -> String.trim_trailing(url, "/") <> path
+      _unset -> @auth_base <> path
+    end
+  end
+
+  def auth_url(url), do: url
+
+  @spec time_scale() :: float()
+  def time_scale do
+    with value when is_binary(value) <- System.get_env("KOGEN_TIME_SCALE"),
+         {scale, ""} when scale > 0 <- Float.parse(value) do
+      scale
+    else
+      _unset ->
+        case Integer.parse(System.get_env("KOGEN_TIME_SCALE") || "") do
+          {scale, ""} when scale > 0 -> scale * 1.0
+          _invalid -> 1.0
+        end
+    end
+  end
+
+  @doc "Scales a constant marked `scaled: true` (never project timeouts)."
+  @spec scale(pos_integer()) :: pos_integer()
+  def scale(ms) when is_integer(ms), do: max(1, round(ms * time_scale()))
+
+  @spec sandbox_unavailable?() :: boolean()
+  def sandbox_unavailable?, do: System.get_env("KOGEN_SANDBOX") == "unavailable"
+
+  @doc "Prints the unconfined warning once per command (§5.3)."
+  @spec warn_sandbox_unavailable() :: :ok
+  def warn_sandbox_unavailable do
+    if sandbox_unavailable?() and :persistent_term.get({__MODULE__, :warned}, false) == false do
+      :persistent_term.put({__MODULE__, :warned}, true)
+
+      IO.puts(
+        :stderr,
+        "kogen: warning: sandbox unavailable: KOGEN_SANDBOX=unavailable; building unconfined"
+      )
+    end
+
+    :ok
+  end
+end
