 "spec": [
  "§3.3",
  "§3.7.2"
 ],
 "project": {
  "checks": [
   {
    "name": "lint",
    "argv": [
     "sh",
     "checks/lint.sh"
    ],
    "timeout_ms": 60000
   },
   {
    "name": "ghost",
    "argv": [
     "kogen-conformance-missing-tool",
     "--check"
    ],
    "timeout_ms": 60000
   }
  ]
 },
 "steps": [
  {
   "intent": "greet"
  },
  {
   "run": [
    "kogen",
    "intent",
    "approve",
    "greet"
   ],
   "expect": {
