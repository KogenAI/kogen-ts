      "budget_ms": 3600000,
      "used_ms": "$int",
      "paused_ms": {
       "$ge": 120000
      }
     }
    }
   }
  }
 ],
 "notes": "paused_ms is asserted in unscaled ms (>= the 120 s wait); SPEC AMBIGUITY: §2.10 does not say whether budget figures are scaled."
}
