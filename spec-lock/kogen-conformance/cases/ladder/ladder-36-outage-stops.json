      {
       "event": "provider_switch"
      }
     ],
     "last": {
      "event": "finished",
      "status": "stopped",
      "reason": "provider/overload"
     }
    }
   }
  },
  {
   "run": [
    "kogen",
    "status",
    "greet"
   ],
   "expect": {
    "exit": 0,
    "stdout": "greet: queued, 1 of 1\n"
   }
  }
 ],
 "notes": "v1.1: a request has at most 4 attempts and the stage is re-run at most 2 more times (§4.5, follows Kogen T66); then the Build stops without judging the Intent."
}
