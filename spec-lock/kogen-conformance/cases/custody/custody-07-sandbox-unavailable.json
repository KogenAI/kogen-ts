      {
       "event": "sandbox_unavailable",
       "reason": "$nonempty"
      },
      {
       "event": "finished",
       "status": "landed"
      }
     ]
    }
   }
  },
  {
   "run": [
    "kogen",
    "status",
    "greet",
    "--json"
   ],
   "expect": {
    "exit": 0,
    "stdout_json": {
     "slug": "greet",
     "status": "landed",
     "sandbox": "unconfined"
    },
    "stderr_any": true
   }
  }
 ]
}
