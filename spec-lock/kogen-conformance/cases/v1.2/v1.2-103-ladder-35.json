{
  "id": "v1.2-103-ladder-35",
  "profile": "v1.2",
  "fixture": "kt",
  "fake": true,
  "title": "v1.2 replacement for ladder-35: A usage limit mid-R2: provider_wait, the budget is paused, the Build continues and lands",
  "spec": [
    "§4.5",
    "§4.1",
    "§2.8",
    "§2.10",
    "§3.4 Budget",
    "§3.6",
    "§4.7"
  ],
  "script": [
    {
      "id": "plan",
      "expect": {
        "role": "planner"
      },
      "reply": {
        "text": "Difficulty: easy\n\n## Acceptance criteria\n- A1: lib/greet.txt contains the line Hello, Almir!\n\n## Technical approach\nReplace the single line in lib/greet.txt.\n\n## Implementation steps\n1. Write Hello, Almir! to lib/greet.txt.\n"
      }
    },
    {
      "id": "r1.start",
      "expect": {
        "role": "builder",
        "model": "gpt-6-luna",
        "effort": "max",
        "turn": 1
      },
      "reply": {
        "calls": [
          {
            "name": "shell",
            "arguments": {
              "cmd": "n=$(cat lib/n 2>/dev/null || echo 0); n=$((n + 1)); echo $n > lib/n; printf 'Hi R1 %s\\n' $n > lib/greet.txt"
            }
          }
        ]
      }
    },
    {
      "id": "r1.again",
      "expect": {
        "role": "builder",
        "model": "gpt-6-luna",
        "effort": "max",
        "last_item_type": "message"
      },
      "repeat": "always",
      "reply": {
        "calls": [
          {
            "name": "shell",
            "arguments": {
              "cmd": "n=$(cat lib/n 2>/dev/null || echo 0); n=$((n + 1)); echo $n > lib/n; printf 'Hi R1 %s\\n' $n > lib/greet.txt"
            }
          }
        ]
      }
    },
    {
      "id": "r1.claim",
      "expect": {
        "role": "builder",
        "model": "gpt-6-luna",
        "effort": "max",
        "last_item_type": "function_call_output"
      },
      "repeat": "always",
      "reply": {
        "calls": [
          {
            "name": "finish",
            "arguments": {}
          }
        ]
      }
    },
    {
      "id": "audit",
      "expect": {
        "role": "auditor"
      },
      "reply": {
        "text": "{\"items\": [{\"id\": \"A1\", \"verdict\": \"valid\", \"citation\": \"\", \"reason\": \"The test follows the Request.\"}]}"
      }
    },
    {
      "id": "r2.limit",
      "expect": {
        "role": "builder",
        "model": "gpt-6.1-sol",
        "effort": "medium",
        "turn": 1
      },
      "reply": {
        "http": {
          "status": 429,
          "headers": {
            "retry-after": "120"
          },
          "body": {
            "error": {
              "type": "usage_limit_reached",
              "message": "usage limit"
            }
          }
        }
      }
    },
    {
      "id": "r2.edit",
      "expect": {
        "role": "builder",
        "model": "gpt-6.1-sol",
        "effort": "medium",
        "turn": 1,
        "tools": [
          "shell",
          "finish",
          "tool_output"
        ]
      },
      "reply": {
        "calls": [
          {
            "name": "shell",
            "arguments": {
              "cmd": "printf 'Hello, Almir!\\n' > lib/greet.txt"
            }
          }
        ]
      }
    },
    {
      "id": "r2.done",
      "expect": {
        "role": "builder",
        "model": "gpt-6.1-sol",
        "effort": "medium",
        "turn": 2,
        "last_item_type": "function_call_output"
      },
      "reply": {
        "calls": [
          {
            "name": "finish",
            "arguments": {}
          }
        ]
      }
    }
  ],
  "steps": [
    {
      "intent": "greet"
    },
    {
      "approve": "greet"
    },
    {
      "run": [
        "kogen",
        "queue",
        "start"
      ],
      "expect": {
        "exit": 0,
        "stdout_lines": [
          "building greet",
          "~\\~landed greet [0-9a-f]{8} \\(Build [0-9a-f]{8}\\)",
          "queue: done; 1 Build(s), 1 landed, 0 not"
        ]
      }
    },
    {
      "assert": {
        "events": {
          "slug": "greet",
          "subsequence": [
            {
              "event": "rung_started",
              "rung": "R2"
            },
            {
              "event": "provider_wait",
              "reason": "~(provider/)?usage_limit",
              "wait_ms": 300000,
              "budget_paused": true
            },
            {
              "event": "finished",
              "status": "landed",
              "rung": "R2"
            }
          ],
          "count": {
            "rung_started": 2
          }
        }
      }
    },
    {
      "run": [
        "kogen",
        "status",
        "greet",
        "--json"
      ],
      "expect": {
        "exit": 0,
        "stdout_json": {
          "budget": {
            "budget_ms": 3600000,
            "used_ms": "$int",
            "paused_ms": {
              "$ge": 1000,
              "$le": 30000
            }
          }
        }
      }
    }
  ],
  "notes": "A Build usage_limit pause is 300,000 ms in the unscaled provider_wait event (§4.5, §2.8). The test seam scales the actual pause to about 3 s at KOGEN_TIME_SCALE=0.01 (§4.1); budget.paused_ms records measured wall time (§2.10). v1.2 replacement for ladder-35. Text-only builder replies are progress; completion requires finish alone with {} (§3.6), and shell recipes expose shell, finish, and tool_output (§4.7)."
}
