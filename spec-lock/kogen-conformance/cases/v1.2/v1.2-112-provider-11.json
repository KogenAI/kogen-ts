{
  "id": "v1.2-112-provider-11",
  "profile": "v1.2",
  "fixture": "kt",
  "fake": true,
  "title": "v1.2 replacement for provider-11: Retry-After does not shorten the 5 minute Build wait",
  "spec": [
    "§4.4",
    "§4.5",
    "§3.6",
    "§4.7"
  ],
  "script": [
    {
      "id": "limit",
      "expect": {
        "role": "planner"
      },
      "reply": {
        "http": {
          "status": 429,
          "headers": {
            "retry-after": "30"
          },
          "body": {
            "error": {
              "message": "slow down"
            }
          }
        }
      }
    },
    {
      "id": "r1_happy.plan",
      "expect": {
        "role": "planner",
        "turn": 1,
        "input_contains": "Greet Almir by name"
      },
      "reply": {
        "text": "Difficulty: easy\n\n## Acceptance criteria\n- A1: lib/greet.txt contains the line Hello, Almir!\n\n## Technical approach\nReplace the single line in lib/greet.txt.\n\n## Implementation steps\n1. Write Hello, Almir! to lib/greet.txt.\n"
      }
    },
    {
      "id": "r1_happy.edit",
      "expect": {
        "role": "builder",
        "turn": 1,
        "tools": [
          "shell",
          "finish",
          "tool_output"
        ],
        "input_contains": "Greet Almir by name"
      },
      "reply": {
        "calls": [
          {
            "name": "shell",
            "arguments": {
              "cmd": "printf 'Hello, Almir!\\n' > lib/greet.txt"
            }
          }
        ]
      }
    },
    {
      "id": "r1_happy.done",
      "expect": {
        "role": "builder",
        "turn": 2,
        "last_output_contains": "exit 0",
        "input_contains": "Greet Almir by name"
      },
      "reply": {
        "calls": [
          {
            "name": "finish",
            "arguments": {}
          }
        ]
      }
    }
  ],
  "steps": [
    {
      "intent": "greet"
    },
    {
      "approve": "greet"
    },
    {
      "run": [
        "kogen",
        "queue",
        "start"
      ],
      "expect": {
        "exit": 0,
        "stdout_lines": [
          "building greet",
          "~\\~landed greet [0-9a-f]{8} \\(Build [0-9a-f]{8}\\)",
          "queue: done; 1 Build(s), 1 landed, 0 not"
        ]
      }
    },
    {
      "assert": {
        "events": {
          "slug": "greet",
          "contains": [
            {
              "event": "provider_wait",
              "reason": "~(provider/)?usage_limit",
              "wait_ms": 300000,
              "budget_paused": true
            }
          ],
          "absent": [
            "provider_retry"
          ]
        }
      }
    }
  ],
  "notes": "The v1.1 fixture expects the 30 s Retry-After value as the Build wait. v1.2 uses a 5 minute usage_limit pause with the budget paused (§4.5). Builder completion uses finish alone with {}; shell recipes expose shell, finish, and tool_output (§3.6, §4.7)."
}
