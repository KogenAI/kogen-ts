{
  "id": "v1.2-66-build-34",
  "profile": "v1.2",
  "fixture": "kt",
  "fake": true,
  "title": "v1.2 replacement for build-34: --detach",
  "spec": [
    "§1.7.4",
    "§3.6",
    "§4.7"
  ],
  "script": [
    {
      "id": "r1_happy.plan",
      "expect": {
        "role": "planner",
        "turn": 1,
        "input_contains": "Greet Almir by name"
      },
      "reply": {
        "text": "Difficulty: easy\n\n## Acceptance criteria\n- A1: lib/greet.txt contains the line Hello, Almir!\n\n## Technical approach\nReplace the single line in lib/greet.txt.\n\n## Implementation steps\n1. Write Hello, Almir! to lib/greet.txt.\n"
      }
    },
    {
      "id": "r1_happy.edit",
      "expect": {
        "role": "builder",
        "turn": 1,
        "tools": [
          "shell",
          "finish",
          "tool_output"
        ],
        "input_contains": "Greet Almir by name"
      },
      "reply": {
        "calls": [
          {
            "name": "shell",
            "arguments": {
              "cmd": "printf 'Hello, Almir!\\n' > lib/greet.txt"
            }
          }
        ]
      }
    },
    {
      "id": "r1_happy.done",
      "expect": {
        "role": "builder",
        "turn": 2,
        "last_output_contains": "exit 0",
        "input_contains": "Greet Almir by name"
      },
      "reply": {
        "calls": [
          {
            "name": "finish",
            "arguments": {}
          }
        ]
      }
    }
  ],
  "steps": [
    {
      "intent": "greet"
    },
    {
      "approve": "greet"
    },
    {
      "run": [
        "kogen",
        "queue",
        "start",
        "--detach"
      ],
      "expect": {
        "exit": 0,
        "stderr": "",
        "stdout_lines": [
          "~queue: started in the background \\(pid [0-9]+\\)",
          "log: {state_root}/queue.log"
        ]
      },
      "capture": {
        "dpid": "pid ([0-9]+)"
      }
    },
    {
      "eventually": {
        "timeout_s": 90,
        "assert": {
          "files": {
            "{state_root}/queue.log": {
              "contains": "queue: done; 1 Build(s), 1 landed, 0 not\n"
            }
          }
        }
      }
    },
    {
      "assert": {
        "files": {
          "{state_root}/queue.log": {
            "regex": "(?m)^building greet$"
          }
        }
      }
    },
    {
      "eventually": {
        "timeout_s": 15,
        "assert": {
          "files": {
            "{state_root}/queue.pid": false
          }
        }
      }
    },
    {
      "run": [
        "kogen",
        "status",
        "greet"
      ],
      "expect": {
        "exit": 0,
        "stdout_starts_lines": [
          "~greet: landed [0-9a-f]{8}"
        ]
      }
    }
  ],
  "notes": "v1.2 replacement for build-34. Text-only builder replies are progress; completion requires finish alone with {} (§3.6). Shell-recipe builders expose shell, finish, and tool_output (§4.7)."
}
