{
  "id": "v1.2-61-build-27",
  "profile": "v1.2",
  "fixture": "kt",
  "fake": true,
  "title": "v1.2 replacement for build-27: A .lock present: landing_retry, then lands once the lock is removed",
  "spec": [
    "§3.9.3",
    "§3.6",
    "§4.7"
  ],
  "script": [
    {
      "id": "plan",
      "expect": {
        "role": "planner",
        "input_contains": "Greet Almir by name"
      },
      "reply": {
        "text": "Difficulty: easy\n\n## Acceptance criteria\n- A1: lib/greet.txt contains the line Hello, Almir!\n\n## Technical approach\nReplace the single line in lib/greet.txt.\n\n## Implementation steps\n1. Write Hello, Almir! to lib/greet.txt.\n"
      }
    },
    {
      "id": "edit",
      "expect": {
        "role": "builder",
        "turn": 1,
        "input_contains": "Greet Almir by name"
      },
      "reply": {
        "calls": [
          {
            "name": "shell",
            "arguments": {
              "cmd": "printf 'Hello, Almir!\\n' > lib/greet.txt"
            }
          }
        ]
      }
    },
    {
      "id": "done",
      "expect": {
        "role": "builder",
        "turn": 2,
        "input_contains": "Greet Almir by name"
      },
      "reply": {
        "calls": [
          {
            "name": "finish",
            "arguments": {}
          }
        ]
      },
      "side_effect_sh": "touch \"$ORIGIN/refs/heads/main.lock\""
    }
  ],
  "time_scale": 1,
  "notes": "Runs unscaled so the 1 s first retry leaves time for the case's watcher to remove refs/heads/main.lock. v1.2 replacement for build-27. Text-only builder replies are progress; completion requires finish alone with {} (§3.6). Shell-recipe builders expose shell, finish, and tool_output (§4.7).",
  "steps": [
    {
      "intent": "greet"
    },
    {
      "approve": "greet"
    },
    {
      "run": [
        "sh",
        "-c",
        "i=0; while [ $i -lt 600 ]; do if grep -q '\"landing_retry\"' \"{state_root}\"/runs/*/events.jsonl 2>/dev/null; then rm -f \"{origin}/refs/heads/main.lock\"; exit 0; fi; sleep 0.05; i=$((i+1)); done; rm -f \"{origin}/refs/heads/main.lock\"; exit 1"
      ],
      "background": "unlock"
    },
    {
      "run": [
        "kogen",
        "queue",
        "start"
      ],
      "expect": {
        "exit": 0,
        "stderr": "",
        "stdout_lines": [
          "building greet",
          "~\\~landed greet [0-9a-f]{8} \\(Build {id8:greet}\\)",
          "queue: done; 1 Build(s), 1 landed, 0 not"
        ]
      }
    },
    {
      "wait": {
        "name": "unlock",
        "expect": {
          "exit": 0,
          "stderr_any": true,
          "utf8_lines": false
        }
      }
    },
    {
      "assert": {
        "events": {
          "slug": "greet",
          "subsequence": [
            "landing_prepared",
            {
              "event": "landing_retry",
              "delay_ms": 1000
            },
            {
              "event": "finished",
              "status": "landed"
            }
          ]
        },
        "files": {
          "{origin}/refs/heads/main.lock": false
        }
      }
    }
  ]
}
