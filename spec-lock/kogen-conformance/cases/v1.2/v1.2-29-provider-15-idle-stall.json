  "spec": [
    "§4.4",
    "§4.5",
    "§3.6",
    "§4.7"
  ],
  "script": [
    {
      "id": "slow",
      "expect": {
        "role": "planner"
      },
      "reply": {
        "text": "Difficulty: easy\n"
