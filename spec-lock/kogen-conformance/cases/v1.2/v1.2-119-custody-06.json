  "notes": "Settled (v1.1): on a host that confines, the escaping write fails and the Build still lands (exit 0); exit 70 applies only when confinement is unavailable and the write is detected. v1.2 replacement for custody-06. Text-only builder replies are progress; completion requires finish alone with {} (§3.6). Shell-recipe builders expose shell, finish, and tool_output (§4.7).",
  "steps": [
    {
      "write": {
        "path": "checks/escape.sh",
        "text": "#!/bin/sh\n# Tries to write into the user's checkout from a Build workspace.\nc=\"{checkout}\"\nif [ \"$(pwd -P)\" != \"$c\" ]; then ( printf 'escaped\\n' >> \"$c/lib/greet.txt\" ) 2>/dev/null; ( true > \"$c/escaped.txt\" ) 2>/dev/null; fi\nexit 0\n"
      }
    },
    {
      "commit": {
        "message": "Add the escape check",
        "push": true
      }
    },
    {
      "intent": "greet"
    },
    {
      "approve": "greet"
    },
    {
      "snapshot": "before"
    },
    {
      "run": [
        "kogen",
        "queue",
        "start"
      ],
      "expect": {
        "exit": 0,
        "stderr_any": true
      }
