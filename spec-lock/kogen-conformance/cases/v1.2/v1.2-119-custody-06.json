        "timeout_ms": 60000
      },
      {
        "name": "unit",
        "argv": [
          "sh",
          "checks/unit.sh"
        ],
        "timeout_ms": 60000
      },
      {
        "name": "escape",
        "argv": [
          "sh",
          "checks/escape.sh"
        ],
        "timeout_ms": 60000
      }
