{
  "id": "v1.2-119-custody-06",
  "profile": "v1.2",
  "fixture": "kt",
  "title": "v1.2 replacement for custody-06: A check writing into the checkout fails (when confined), and in every case the checkout is unchanged after the Build",
  "spec": [
    "§5.3",
    "§5.5.6",
    "§3.6",
    "§4.7"
  ],
  "fake": true,
  "script": [
