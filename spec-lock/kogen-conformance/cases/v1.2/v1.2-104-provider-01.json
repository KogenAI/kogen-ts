{
  "id": "v1.2-104-provider-01",
  "profile": "v1.2",
  "fixture": "kt",
  "fake": true,
  "title": "v1.2 replacement for provider-01: Injected request uses canonical tools and v1.2 controls",
  "spec": [
    "§4.2",
    "§4.6",
    "§3.6",
    "§4.7"
  ],
  "script": [
    {
      "id": "r1_happy.plan",
      "expect": {
        "role": "planner",
        "turn": 1,
        "input_contains": "Greet Almir by name"
      },
      "reply": {
        "text": "Difficulty: easy\n\n## Acceptance criteria\n- A1: lib/greet.txt contains the line Hello, Almir!\n\n## Technical approach\nReplace the single line in lib/greet.txt.\n\n## Implementation steps\n1. Write Hello, Almir! to lib/greet.txt.\n"
      }
    },
    {
      "id": "r1_happy.edit",
      "expect": {
        "role": "builder",
        "turn": 1,
        "tools": [
          "shell",
          "finish",
          "tool_output"
        ],
        "input_contains": "Greet Almir by name"
      },
      "reply": {
        "calls": [
          {
            "name": "shell",
            "arguments": {
              "cmd": "printf 'Hello, Almir!\\n' > lib/greet.txt"
            }
          }
        ]
      }
    },
    {
      "id": "r1_happy.done",
      "expect": {
        "role": "builder",
        "turn": 2,
        "last_output_contains": "exit 0",
        "input_contains": "Greet Almir by name"
      },
      "reply": {
        "calls": [
          {
            "name": "finish",
            "arguments": {}
          }
        ]
      }
    }
  ],
  "steps": [
    {
      "intent": "greet"
    },
    {
      "approve": "greet"
    },
    {
      "run": [
        "kogen",
        "queue",
        "start"
      ],
      "expect": {
        "exit": 0,
        "stdout_lines": [
          "building greet",
          "~\\~landed greet [0-9a-f]{8} \\(Build [0-9a-f]{8}\\)",
          "queue: done; 1 Build(s), 1 landed, 0 not"
        ]
      }
    },
    {
      "assert": {
        "fake_requests": [
          {
            "select": {
              "step": "r1_happy.edit"
            },
            "match": {
              "headers": {
                "authorization": "~Bearer [A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+",
                "content-type": "~application/json.*",
                "accept": "text/event-stream",
                "user-agent": "~kogen/\\S+",
                "chatgpt-account-id": "acct_kogen_test",
                "openai-beta": "responses=experimental",
                "originator": "kogen",
                "session-id": "$hex64",
                "thread-id": "$hex64"
              },
              "body": {
                "model": "gpt-6-luna",
                "instructions": "~(?s).*You are Kogen's builder\\..*",
                "input": "$list",
                "reasoning": {
                  "$exact": true,
                  "effort": "max"
                },
                "store": false,
                "stream": true,
                "prompt_cache_key": "$hex64",
                "tools": {
                  "$len": 3,
                  "$contains": [
                    {
                      "name": "shell"
                    },
                    {
                      "name": "finish",
                      "strict": true
                    },
                    {
                      "name": "tool_output"
                    }
                  ]
                },
                "include": [
                  "reasoning.encrypted_content"
                ],
                "tool_choice": {
                  "type": "allowed_tools",
                  "mode": "auto",
                  "tools": {
                    "$len": 3,
                    "$contains": [
                      {
                        "type": "function",
                        "name": "shell"
                      },
                      {
                        "type": "function",
                        "name": "finish"
                      },
                      {
                        "type": "function",
                        "name": "tool_output"
                      }
                    ]
                  }
                },
                "parallel_tool_calls": false,
                "text": {
                  "verbosity": "low"
                }
              }
            }
          },
          {
            "select": {
              "step": "r1_happy.plan"
            },
            "match": {
              "headers": {
                "chatgpt-account-id": "acct_kogen_test",
                "openai-beta": "responses=experimental",
                "originator": "kogen",
                "accept": "text/event-stream"
              },
              "body": {
                "model": "gpt-6.1-sol",
                "reasoning": {
                  "$exact": true,
                  "effort": "high",
                  "summary": "auto"
                },
                "store": false,
                "stream": true,
                "prompt_cache_key": "$hex64",
                "tools": {
                  "$len": 3,
                  "$contains": [
                    {
                      "name": "shell"
                    },
                    {
                      "name": "finish",
                      "strict": true
                    },
                    {
                      "name": "tool_output"
                    }
                  ]
                },
                "instructions": "$nonempty",
                "input": "$list",
                "previous_response_id": "$absent",
                "tool_choice": "none",
                "parallel_tool_calls": false,
                "max_output_tokens": "$absent",
                "temperature": "$absent"
              }
            }
          }
        ]
      }
    }
  ],
  "notes": "Whether tool-less roles in injected mode still send `include` is not stated; the planner body is checked without `$exact`. v1.2 replacement for provider-01. Text-only builder replies are progress; completion requires finish alone with {} (§3.6). Shell-recipe builders expose shell, finish, and tool_output (§4.7). Tool-less roles retain the shared canonical schemas and use tool_choice: none (§4.2)."
}
