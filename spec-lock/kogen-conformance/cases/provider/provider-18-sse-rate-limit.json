{
 "id": "provider-18",
 "profile": "provider",
 "fixture": "kt",
 "fake": true,
 "title": "An SSE rate_limit event counts as a usage limit",
 "spec": [
  "§4.3",
  "§4.5"
 ],
 "script": [
  {
   "id": "rl",
   "expect": {
    "role": "planner"
   },
   "reply": {
    "sse": [
     "event: error\ndata: {\"type\": \"error\", \"error\": {\"type\": \"rate_limit_exceeded\", \"message\": \"Rate limit reached for requests\"}}\n\n"
    ]
   }
  },
  {
   "include": "r1_happy"
  }
 ],
 "steps": [
  {
   "intent": "greet"
  },
  {
   "approve": "greet"
  },
  {
   "run": [
    "kogen",
    "queue",
    "start"
   ],
   "expect": {
    "exit": 0,
    "stdout_lines": [
     "building greet",
     "~landed greet [0-9a-f]{8} \\(Build [0-9a-f]{8}\\)",
     "queue: done; 1 Build(s), 1 landed, 0 not"
    ]
   }
  },
  {
   "assert": {
    "events": {
     "slug": "greet",
     "contains": [
      {
       "event": "provider_wait",
       "reason": "~(provider/)?usage_limit",
       "wait_ms": 900000,
       "budget_paused": true
      }
     ]
    }
   }
  }
 ],
 "notes": "No retry_after, so the 15-minute default (9 s real) applies."
}
