{
 "id": "provider-02",
 "profile": "provider",
 "fixture": "kt",
 "fake": true,
 "title": "Owned-mode request after login: the additional_tools item",
 "spec": [
  "§4.2",
  "§4.6"
 ],
 "script": [
  {
   "include": "r1_happy"
  }
 ],
 "steps": [
  {
   "run": [
    "kogen",
    "provider",
    "login",
    "chatgpt"
   ],
   "timeout": 90,
   "expect": {
    "exit": 0,
    "stdout_contains": "chatgpt:default signed in"
   }
  },
  {
   "intent": "greet"
  },
  {
   "approve": "greet"
  },
  {
   "run": [
    "kogen",
    "queue",
    "start"
   ],
   "expect": {
    "exit": 0,
    "stdout_lines": [
     "building greet",
     "~landed greet [0-9a-f]{8} \\(Build [0-9a-f]{8}\\)",
     "queue: done; 1 Build(s), 1 landed, 0 not"
    ]
   }
  },
  {
   "assert": {
    "fake_requests": [
     {
      "select": {
       "step": "r1_happy.edit"
      },
      "match": {
       "headers": {
        "authorization": "~Bearer \\S+",
        "accept": "text/event-stream",
        "chatgpt-account-id": "$absent",
        "openai-beta": "$absent",
        "originator": "$absent"
       },
       "body": {
        "tools": "$absent",
        "include": "$absent",
        "input": {
         "$subsequence": [
          {
           "$exact": true,
           "type": "additional_tools",
           "role": "developer",
           "tools": [
            {
             "type": "function",
             "name": "shell",
             "description": "$nonempty",
             "parameters": {
              "type": "object",
              "properties": {
               "$has_keys": [
                "cmd"
               ]
              },
              "required": [
               "cmd"
              ],
              "additionalProperties": false
             },
             "strict": false
            }
           ]
          },
          {
           "role": "user"
          }
         ]
        },
        "previous_response_id": "$absent",
        "tool_choice": "$absent",
        "parallel_tool_calls": "$absent",
        "max_output_tokens": "$absent",
        "temperature": "$absent"
       }
      }
     },
     {
      "select": {
       "step": "r1_happy.plan"
      },
      "match": {
       "body": {
        "tools": "$absent",
        "input": {
         "$not": {
          "$contains": [
           {
            "type": "additional_tools"
           }
          ]
         }
        }
       }
      }
     }
    ]
   }
  }
 ],
 "needs": [
  "login"
 ],
 "serial": true,
 "auth": "owned"
}
