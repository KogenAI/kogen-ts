   }
  },
  {
   "id": "t1",
   "expect": {
    "role": "builder",
    "model": "gpt-6-luna",
    "effort": "max",
    "turn": 1
   },
   "reply": {
    "calls": [
     {
      "name": "shell",
      "arguments": {
       "cmd": "printf 'Hello, Almir!\\n' > lib/greet.txt; exit 3"
      }
     }
    ]
   }
  },
  {
   "id": "t2",
   "expect": {
    "role": "builder",
    "model": "gpt-6-luna",
    "effort": "max",
    "turn": 2,
    "last_output_contains": "exit 3"
   },
   "reply": {
    "calls": [
     {
      "name": "shell",
      "arguments": {
       "cmd": "sleep 200"
      }
     }
    ]
   }
  },
  {
   "id": "t3",
   "expect": {
    "role": "builder",
    "model": "gpt-6-luna",
    "effort": "max",
    "turn": 3,
    "last_output_contains": "timed out after 120 seconds"
   },
   "reply": {
    "calls": [
     {
      "name": "shell",
      "arguments": {
       "cmd": "head -c 15000 /dev/zero | tr '\\000' 'x'; echo; echo END-OF-OUTPUT"
      }
     }
    ]
   }
  },
  {
   "id": "t4",
   "expect": {
    "role": "builder",
    "model": "gpt-6-luna",
    "effort": "max",
