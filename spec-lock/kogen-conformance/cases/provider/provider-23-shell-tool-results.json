    "last_output_contains": "END-OF-OUTPUT"
   },
   "reply": {
    "calls": [
     {
      "name": "shell",
      "arguments": {
       "cmd": "printf '\\377\\376abc'"
      }
     }
    ]
   }
  },
  {
   "id": "t5",
   "expect": {
    "role": "builder",
    "model": "gpt-6-luna",
    "effort": "max",
    "turn": 5,
    "last_output_contains": "[non-UTF-8 output tail, base64 encoded]"
   },
   "reply": {
    "text": "Done."
   }
  }
 ],
 "steps": [
  {
   "intent": "greet"
  },
  {
   "approve": "greet"
