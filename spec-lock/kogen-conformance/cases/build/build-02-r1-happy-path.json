{
 "id": "build-02",
 "profile": "build",
 "fixture": "kt",
 "fake": true,
 "title": "R1 happy path: requests, landed commit, refs and workspaces",
 "spec": [
  "§3.1",
  "§3.4",
  "§3.6",
  "§2.5.4",
  "§4.2"
 ],
 "script": [
  {
   "include": "r1_happy"
  }
 ],
 "steps": [
  {
   "intent": "greet"
  },
  {
   "approve": "greet"
  },
  {
   "git": [
    "rev-parse",
    "main"
   ],
   "in": "origin",
   "capture": {
    "base0": "^([0-9a-f]+)"
   }
  },
  {
   "run": [
    "kogen",
    "queue",
    "start"
   ],
   "expect": {
    "exit": 0,
    "stderr": "",
    "stdout_lines": [
     "building greet",
     "~landed greet [0-9a-f]{8} \\(Build {id8:greet}\\)",
     "queue: done; 1 Build(s), 1 landed, 0 not"
    ]
   },
   "capture": {
    "landed8": "landed greet ([0-9a-f]{8})"
   }
  },
  {
   "assert": {
    "fake_requests": [
     {
      "select": {
       "role": "planner"
      },
      "match": {
       "body": {
        "tools": "$absent",
        "input": {
         "$each": {
          "$not": {
           "type": "additional_tools"
          }
         }
        }
       }
      },
      "input_contains": [
       "---\ntitle: Greet Almir by name\nsize: small\ndomains: [app]\n---\nChange the greeting in lib/greet.txt so that it names Almir.\n\n## Acceptance\n- A1: lib/greet.txt contains the line Hello, Almir!\n\n## Verify\n- A1: test\n\n## Request\nMake the greeting in lib/greet.txt say Hello, Almir! instead of Hello!\n",
       "lib/greet.txt",
       "checks/lint.sh",
       "run-acceptance.sh",
       ".kogen/project.yaml"
      ]
     },
     {
      "select": {
       "role": "builder",
       "turn": 1
      },
      "match": {
       "body": {
        "instructions": {
         "$contains_text": "You are Kogen's builder."
        }
       }
      },
      "input_contains": [
       "Approved Intent:\n",
       "## Request\nMake the greeting",
       "Acceptance on the base:",
       "A1 (test): failed",
       "Begin work in the supplied worktree."
      ]
     }
    ],
    "git": [
     {
      "args": [
       "log",
       "-1",
       "--format=%B",
       "main"
      ],
      "stdout": "Greet Almir by name\n\nKogen-Intent: greet\n\n"
     },
     {
      "args": [
       "log",
       "-1",
       "--format=%P",
       "main"
      ],
      "stdout": "{var:base0}\n"
     },
     {
      "args": [
       "rev-parse",
       "main"
      ],
      "stdout_regex": "\\A{var:landed8}"
     },
     {
      "args": [
       "cat-file",
       "-p",
       "main:lib/greet.txt"
      ],
      "stdout": "Hello, Almir!\n"
     },
     {
      "args": [
       "cat-file",
       "-p",
       "main:.kogen/intents/greet/intent.md"
      ],
      "stdout": "---\ntitle: Greet Almir by name\nsize: small\ndomains: [app]\n---\nChange the greeting in lib/greet.txt so that it names Almir.\n\n## Acceptance\n- A1: lib/greet.txt contains the line Hello, Almir!\n\n## Verify\n- A1: test\n\n## Request\nMake the greeting in lib/greet.txt say Hello, Almir! instead of Hello!\n"
     },
     {
      "args": [
       "cat-file",
       "-p",
       "main:test/acceptance/greet.t.sh"
      ],
      "stdout": "t_A1() { grep -qx 'Hello, Almir!' lib/greet.txt; }\n"
     },
     {
      "args": [
       "ls-tree",
       "-r",
       "--name-only",
       "main"
      ],
      "stdout_not_regex": "(?m)^\\.kogen/acceptance/greet\\.t\\.sh$"
     },
     {
      "args": [
       "diff",
       "--name-only",
       "{var:base0}",
       "main"
      ],
      "stdout": ".kogen/intents/greet/intent.md\nlib/greet.txt\ntest/acceptance/greet.t.sh\n"
     }
    ],
    "refs": {
     "refs/kogen/claim": false
    },
    "ref_count": {
     "refs/kogen/incoming/": 0
    },
    "glob_count": {
     "{state_root}/{run_id:greet}-*": 0
    }
   }
  }
 ],
 "notes": "git log %B adds one newline after the message, so the stored message is exactly '<title>\\n\\nKogen-Intent: greet\\n'."
}
