{
 "id": "build-30",
 "profile": "build",
 "fixture": "kt",
 "fake": true,
 "title": "The builder deletes, renames, sets chmod +x, adds a symlink and commits: the landed tree is correct",
 "spec": [
  "§3.9.1",
  "§5.4"
 ],
 "script": [
  {
   "id": "plan",
   "expect": {
    "role": "planner",
    "input_contains": "Greet Almir by name"
   },
   "reply": {
    "text": "Difficulty: easy\n\n## Acceptance criteria\n- A1: lib/greet.txt contains the line Hello, Almir!\n\n## Technical approach\nReplace the single line in lib/greet.txt.\n\n## Implementation steps\n1. Write Hello, Almir! to lib/greet.txt.\n"
   }
  },
  {
   "id": "edit",
   "expect": {
    "role": "builder",
    "turn": 1,
    "input_contains": "Greet Almir by name"
   },
   "reply": {
    "calls": [
     {
      "name": "shell",
      "arguments": {
       "cmd": "git rm -q lib/a.txt && git mv lib/b.txt lib/c.txt && chmod +x lib/run.sh && ln -s greet.txt lib/link.txt && printf 'Hello, Almir!\\n' > lib/greet.txt && git add -A && git commit -q -m 'builder commit'"
      }
     }
    ]
   }
  },
  {
   "id": "done",
   "expect": {
    "role": "builder",
    "turn": 2,
    "input_contains": "Greet Almir by name"
   },
   "reply": {
    "text": "Done."
   }
  }
 ],
 "fixture_files": {
  "lib/a.txt": "a\n",
  "lib/b.txt": "b\n",
  "lib/run.sh": "echo run\n"
 },
 "steps": [
  {
   "intent": "greet"
  },
  {
   "approve": "greet"
  },
  {
   "git": [
    "rev-parse",
    "main"
   ],
   "in": "origin",
   "capture": {
    "base0": "^([0-9a-f]+)"
   }
  },
  {
   "run": [
    "kogen",
    "queue",
    "start"
   ],
   "expect": {
    "exit": 0,
    "stderr": "",
    "stdout_lines": [
     "building greet",
     "~landed greet [0-9a-f]{8} \\(Build {id8:greet}\\)",
     "queue: done; 1 Build(s), 1 landed, 0 not"
    ]
   }
  },
  {
   "assert": {
    "git": [
     {
      "args": [
       "ls-tree",
       "main",
       "lib/"
      ],
      "stdout_regex": [
       "\\A100644 blob [0-9a-f]+\tlib/c\\.txt\n100644 blob [0-9a-f]+\tlib/greet\\.txt\n120000 blob [0-9a-f]+\tlib/link\\.txt\n100755 blob [0-9a-f]+\tlib/run\\.sh\n\\Z"
      ]
     },
     {
      "args": [
       "cat-file",
       "-p",
       "main:lib/link.txt"
      ],
      "stdout": "greet.txt"
     },
     {
      "args": [
       "cat-file",
       "-p",
       "main:lib/c.txt"
      ],
      "stdout": "b\n"
     },
     {
      "args": [
       "log",
       "-1",
       "--format=%P",
       "main"
      ],
      "stdout": "{var:base0}\n"
     },
     {
      "args": [
       "log",
       "-1",
       "--format=%B",
       "main"
      ],
      "stdout": "Greet Almir by name\n\nKogen-Intent: greet\n\n"
     }
    ]
   }
  }
 ]
}
