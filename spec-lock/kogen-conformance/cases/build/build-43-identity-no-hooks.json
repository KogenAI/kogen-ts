{
 "id": "build-43",
 "profile": "build",
 "fixture": "kt",
 "fake": true,
 "title": "Commit identity is the git config identity; hooks never run",
 "spec": [
  "§2.5.4",
  "§5.4",
  "§6.3"
 ],
 "script": [
  {
   "include": "r1_happy"
  }
 ],
 "steps": [
  {
   "intent": "greet"
  },
  {
   "approve": "greet"
  },
  {
   "write": {
    "path": "{case}/hooks/pre-commit",
    "text": "#!/bin/sh\necho \"$0\" >> \"{case}/hooks-ran\"\nexit 1\n",
    "mode": "755"
   }
  },
  {
   "write": {
    "path": "{case}/hooks/commit-msg",
    "text": "#!/bin/sh\necho \"$0\" >> \"{case}/hooks-ran\"\nexit 1\n",
    "mode": "755"
   }
  },
  {
   "write": {
    "path": "{case}/hooks/pre-push",
    "text": "#!/bin/sh\necho \"$0\" >> \"{case}/hooks-ran\"\nexit 1\n",
    "mode": "755"
   }
  },
  {
   "write": {
    "path": "{case}/hooks/post-commit",
    "text": "#!/bin/sh\necho \"$0\" >> \"{case}/hooks-ran\"\nexit 1\n",
    "mode": "755"
   }
  },
  {
   "write": {
    "path": "{case}/gitconfig",
    "append": true,
